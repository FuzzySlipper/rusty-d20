{
  "name": "rusty-d20",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm run serve:local",
    "build": "nx run-many -t build --all",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "test": "vitest run --passWithNoTests",
    "verify": "./scripts/verify.sh",
    "verify:rust": "cargo fmt --check && cargo test --workspace --locked && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "verify:rules": "./scripts/verify-rules.sh",
    "verify:ui": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:boundaries": "pnpm run check:pattern && pnpm run check:docs && node tools/scripts/check-product-boundaries.mjs && pnpm run protocol:check",
    "verify:build": "pnpm run build",
    "verify:browser": "pnpm run e2e",
    "native": "cargo run -p rusty-d20 --bin rusty-d20-native --",
    "verify:native": "./scripts/verify-native-host.sh",
    "check:pattern": "node tools/scripts/check-pattern.mjs",
    "check:docs": "node tools/scripts/check-docs-commands.mjs",
    "protocol:generate": "cargo run -p rusty-d20 --bin rusty-d20-protocol -- libs/protocol/src/generated/api-types.ts",
    "protocol:check": "cargo run -p rusty-d20 --bin rusty-d20-protocol -- --check libs/protocol/src/generated/api-types.ts",
    "serve:local": "node tools/scripts/serve-local.mjs",
    "e2e": "pnpm run build && nx e2e app-e2e",
    "e2e:live": "playwright test --config apps/app-e2e/playwright.config.mts --grep @live"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@eslint/js": "^9.39.4",
    "@nx/angular": "23.0.1",
    "@nx/devkit": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/playwright": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.0",
    "@typescript-eslint/utils": "^8.61.1",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.4.0",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
