{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@rusty-d20/components": ["libs/components/src/index.ts"],
      "@rusty-d20/domain": ["libs/domain/src/index.ts"],
      "@rusty-d20/feature-main-menu": ["libs/feature-main-menu/src/index.ts"],
      "@rusty-d20/platform": ["libs/platform/src/index.ts"],
      "@rusty-d20/protocol": ["libs/protocol/src/index.ts"],
      "@rusty-d20/renderer": ["libs/renderer/src/index.ts"],
      "@rusty-d20/shell": ["libs/shell/src/index.ts"],
      "@rusty-d20/store": ["libs/store/src/index.ts"],
      "@rusty-d20/testing-fixtures": ["libs/testing-fixtures/src/index.ts"],
      "@rusty-d20/theme": ["libs/theme/src/index.ts"],
      "@rusty-d20/transport": ["libs/transport/src/index.ts"],
      "@rusty-d20/ui-character-status": ["libs/ui-character-status/src/index.ts"],
      "@rusty-d20/ui-combat-log": ["libs/ui-combat-log/src/index.ts"],
      "@rusty-d20/ui-compass": ["libs/ui-compass/src/index.ts"],
      "@rusty-d20/ui-equipment": ["libs/ui-equipment/src/index.ts"],
      "@rusty-d20/ui-hotbar": ["libs/ui-hotbar/src/index.ts"],
      "@rusty-d20/ui-inventory": ["libs/ui-inventory/src/index.ts"],
      "@rusty-d20/ui-minimap": ["libs/ui-minimap/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "coverage"]
}
